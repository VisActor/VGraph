{
  "name": "@dp/xgraph",
  "version": "2.0.15",
  "description": "",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "esm",
    "dist"
  ],
  "scripts": {
    "prebuild": "npx eslint src/**/*.ts",
    "build": "npm run build:cjs",
    "build:umd": "webpack --config webpack.pro.config.js --mode production",
    "build:cjs": "tsc -p tsconfig.json --target ES5 --module commonjs --outDir lib",
    "build:esm": "tsc --module ESNext --outDir esm",
    "prepare": "npm run build:cjs && npm run build:umd && npm run build:esm",
    "prestart": "npm run build",
    "start": "webpack-dev-server --open --hot",
    "test": "npx jest --config jest.config.js",
    "coverage": "npx jest --config jest.config.js --coverage",
    "clear": "rm -r dist/* || true",
    "watch": "npx tsc -w -m ES2015 --outDir lib",
    "lint": "node nonsrc.js && npx eslint src/**/*.ts",
    "lint:fix": "npx eslint --fix src/**/*.ts",
    "declare": "npm run build:esm && node description.js"
  },
  "pre-commit": {
    "run": [
      "lint",
      "test"
    ],
    "silent": false
  },
  "repository": {
    "type": "git",
    "url": "git@code.byted.org:dp/xgraph.git"
  },
  "bugs": {
    "url": "https://xgraph.web.bytedance.net/home"
  },
  "homepage": "https://xgraph.web.bytedance.net/home",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@byted-lint/eslint-plugin-meta": "0.0.25",
    "@types/d3-ease": "^3.0.0",
    "@types/d3-interpolate": "^3.0.1",
    "@types/d3-timer": "^3.0.1",
    "@types/d3-quadtree": "^3.0.2",
    "@types/jest": "^27.0.2",
    "@types/jsdom": "^16.2.13",
    "@types/node": "^16.11.7",
    "babel-jest": "^27.3.1",
    "babel-loader": "^9.1.2",
    "canvas": "2.8.0",
    "eslint": "7.32.0",
    "glob": "^7.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.3.1",
    "jsdom": "^18.0.1",
    "pre-commit": "^1.2.2",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4",
    "webpack": "^5.63.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.4.0",
    "worker-loader": "^3.0.8"
  },
