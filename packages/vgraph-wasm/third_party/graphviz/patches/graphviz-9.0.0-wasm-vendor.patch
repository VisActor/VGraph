+		pp->order = (int)(MC_SCALE * angle / (2 * M_PI));
+	}
+	pp->constrained = constrain;
+	pp->defined = defined;
+	pp->clip = clip;
+	pp->dyna = dyna;
+	return rv;
 }
 
