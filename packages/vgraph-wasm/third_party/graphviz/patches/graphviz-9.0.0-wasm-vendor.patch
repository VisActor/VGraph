+				constrain = true;
+				defined = true;
+				clip = false;
+				side = sides & LEFT;
+			}
+			break;
+		case 'n':
+			p.y = b.UR.y;
+			constrain = true;
+			clip = false;
+			switch (*compass)
+			{
+			case '\0':
+				defined = true;
