{
  "name": "@visactor/react-vgraph-ui",
  "version": "0.1.0",
  "description": "React UI components for VGraph",
  "keywords": [
    "react",
    "graph",
    "visualization",
    "canvas",
    "vgraph",
    "VisActor",
    "ui"
  ],
  "author": {
    "name": "VisActor",
    "url": "https://visactor.io/"
  },
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "cjs",
    "es",
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./cjs/index.js",
      "import": "./es/index.js"
    }
  },
  "scripts": {
    "prebuild": "npx eslint src/**/*.tsx",
    "build": "father build",
    "lint": "npx eslint src/**/*.ts",
    "lint:fix": "npx eslint --fix src/**/*.ts",
    "prepublishOnly": "npm run build",
    "start": "webpack-dev-server --open --hot",
    "demo": "webpack-dev-server --open --hot",
    "test": "jest --silent --config jest.config.js --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "clear": "rm -r dist/* || true"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@arco-design/web-react": "2.39.3",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@internal/eslint-config": "workspace:*",
    "@rushstack/eslint-patch": "~1.1.4",
    "@visactor/vgraph": "workspace:*",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "12",
    "@types/jest": "^27.0.2",
    "@types/jsdom": "^16.2.13",
    "@types/node": "*",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@umijs/fabric": "^2.8.1",
    "@umijs/test": "^3.0.5",
    "babel-jest": "^27.3.1",
    "babel-loader": "^9.1.2",
    "css-loader": "6.11.0",
    "eslint": "~8.18.0",
    "father": "^4.5.0",
    "glob": "^7.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.3.1",
    "jsdom": "^18.0.1",
    "less": "^4.2.0",
    "less-loader": "11.1.0",
    "portfinder": "^1.0.32",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "style-loader": "3.3.4",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "typescript": "4.9.5",
    "webpack": "^5.63.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.4.0",
    "worker-loader": "^3.0.8"
  },
  "peerDependencies": {
    "@visactor/vgraph": "^0.1.0",
    "@arco-design/web-react": "^2.39.3",
    "react": ">=16",
    "react-dom": ">=16",
    "@types/react": ">=16"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VisActor/vgraph.git",
    "directory": "packages/react-vgraph-ui"
  },
  "bugs": {
    "url": "https://github.com/VisActor/vgraph/issues"
  },
  "homepage": "https://visactor.io/vgraph",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
