{
  "name": "@visactor/vgraph",
  "version": "0.1.0-alpha.0",
  "description": "graph visualization engine",
  "main": "cjs/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "cjs",
    "es",
    "dist"
  ],
  "scripts": {
    "demo": "node scripts/demo.js",
    "compile": "tsc --noEmit",
    "eslint": "eslint --debug --fix src/",
    "build": "npm run build:cjs && npm run build:umd && npm run build:esm",
    "dev": "tsc -p tsconfig.json --module ESNext --outDir es -w",
    "start": "node scripts/demo.js",
    "test": "jest --silent --config jest.config.js",
    "test-cov": "jest --coverage --config jest.config.js",
    "build:umd": "webpack --config webpack.pro.config.js --mode production",
    "build:cjs": "tsc -p tsconfig.json --target ES5 --module commonjs --outDir cjs",
    "build:esm": "tsc -p tsconfig.json --module ESNext --outDir es",
    "build:es": "npm run build:esm",
    "clear": "rm -r dist/* || true",
    "watch": "tsc -w -m ES2015 --outDir cjs",
    "lint": "node nonsrc.js && eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "declare": "npm run build:esm && node description.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VisActor/vgraph.git",
    "directory": "packages/vgraph"
  },
  "bugs": {
    "url": "https://github.com/VisActor/vgraph/issues"
  },
  "homepage": "https://visactor.io/vgraph",
  "keywords": [
    "graph",
    "visualization",
    "canvas",
    "vgraph",
    "VisActor"
  ],
  "author": {
    "name": "VisActor",
    "url": "https://visactor.io/"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@internal/bundler": "workspace:*",
    "@internal/eslint-config": "workspace:*",
    "@internal/ts-config": "workspace:*",
    "@rushstack/eslint-patch": "~1.1.4",
    "@types/d3-ease": "^3.0.0",
    "@types/d3-interpolate": "^3.0.1",
    "@types/d3-timer": "^3.0.1",
    "@types/d3-quadtree": "^3.0.2",
    "@types/jest": "^27.0.2",
    "@types/jsdom": "^16.2.13",
    "@types/node": "*",
    "babel-jest": "^27.3.1",
    "babel-loader": "^9.1.2",
    "canvas": "3.2.3",
    "eslint": "~8.18.0",
    "glob": "^7.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^27.3.1",
    "jsdom": "^18.0.1",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "typescript": "4.9.5",
    "webpack": "^5.63.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.4.0",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "eventemitter3": "^4.0.7",
    "d3-timer": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-quadtree": "^3.0.1"
  }
}
